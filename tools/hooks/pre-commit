#!/bin/sh
# Blocca qualsiasi commit che contenga materiale privato, anche con `git add -f`.
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '^sources/(.+)$|\.(png|jpe?g|heic|webp|gif|pdf)$' | grep -v '^sources/README.md$' || true)
if [ -n "$bad" ]; then
  echo "COMMIT BLOCCATO: questi file non devono essere pubblicati:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  exit 1
fi


# Se cambia qualcosa in docs/assets/, aggiorna il numero di versione (?v=) su
# tutti i link a style.css / quiz.js / icone.js nelle pagine, così i browser
# scaricano i file nuovi appena ricaricano la pagina (Pages li tiene 10 minuti).
if git diff --cached --name-only | grep -q '^docs/assets/'; then
  v=$(date +%Y%m%d%H%M)
  find docs -name '*.html' -print0 | xargs -0 sed -i -E "s#(assets/(style\.css|quiz\.js|icone\.js))(\?v=[0-9]+)?#\1?v=$v#g"
  git add docs
fi
