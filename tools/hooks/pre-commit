#!/bin/sh
# Blocca qualsiasi commit che contenga materiale privato, anche con `git add -f`.
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '^sources/(.+)$|\.(png|jpe?g|heic|webp|gif|pdf)$' | grep -v '^sources/README.md$' || true)
if [ -n "$bad" ]; then
  echo "COMMIT BLOCCATO: questi file non devono essere pubblicati:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  exit 1
fi

# Se cambia l'elenco, aggiorna il numero di versione in index.html così i
# browser non usano una copia vecchia dell'elenco.
if git diff --cached --name-only | grep -q '^docs/assets/elenco.js$'; then
  v=$(date +%Y%m%d%H%M)
  sed -i "s|assets/elenco.js?v=[0-9a-z]*|assets/elenco.js?v=$v|" docs/index.html
  git add docs/index.html
fi
